DATABASE_URL=postgresql+psycopg://auditor:auditor@db:5432/memory_auditor
VITE_API_URL=http://localhost:8000/api/v1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# The memory-extraction and test-generation pipeline. API keys stay backend-only.
# Choose one of: rule_based, openai, deepseek, gemini
PIPELINE_PROVIDER=rule_based
# Optional provider model override. Leave blank to use the project's default model.
PIPELINE_MODEL=
# The optional LLM-as-judge. API keys remain backend-only.
# Choose one of: rule_based, openai, deepseek, gemini
EVALUATOR_PROVIDER=rule_based
# Optional provider model override. Leave blank to use the project's default model.
EVALUATOR_MODEL=
# Private writer used by the controlled target Agent. It never receives
# reviewer-confirmed ground truth. Choose rule_based or llm_structured.
TARGET_MEMORY_WRITER=rule_based
