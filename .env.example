DATABASE_URL=postgresql+psycopg://auditor:auditor@db:5432/memory_auditor
VITE_API_URL=http://localhost:8000/api/v1
# Guardrail for authorised JSON uploads. This is an API-body limit, in bytes.
MAX_REQUEST_BYTES=5000000
MAX_AUDIT_TARGET_CALLS=100
MAX_AUDIT_EXECUTION_SECONDS=300
# Set by CI or the Docker build so frozen experiment artifacts identify code.
AUDITOR_CODE_REVISION=development
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Local target AI via Ollama. In Docker Desktop on macOS, host.docker.internal
# reaches the Ollama service running on the host. Native backend users can set
# this to http://127.0.0.1:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3:1.7b
# Conservative M1 8 GB defaults for a small local text-only target run.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=120
# The memory-extraction and test-generation pipeline. API keys stay backend-only.
# New cloud calls use openrouter; choose rule_based for offline development.
PIPELINE_PROVIDER=openrouter
# Optional provider model override. Leave blank to use the project's default model.
PIPELINE_MODEL=google/gemini-2.5-flash-lite
# The optional LLM-as-judge. API keys remain backend-only.
# New cloud calls use openrouter; choose rule_based for offline development.
EVALUATOR_PROVIDER=openrouter
# Optional provider model override. Leave blank to use the project's default model.
EVALUATOR_MODEL=google/gemini-2.5-flash-lite
# Private writer used by the controlled target Agent. It never receives
# reviewer-confirmed ground truth. Choose rule_based or llm_structured.
TARGET_MEMORY_WRITER=rule_based
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=
# Optional fixed upstream provider slug for controlled experiments.
OPENROUTER_PROVIDER=

# Local workspace ports bind only to 127.0.0.1. Require operator sign-in before sharing.
AUDITOR_ACCESS_MODE=local
AUDITOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUDITOR_COOKIE_SECURE=true
AUDITOR_SESSION_SECONDS=14400
# Owner creates this with python -m app.security.credentials; retain single quotes.
AUDITOR_OPERATOR_PASSWORD_HASH=
AUDITOR_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
